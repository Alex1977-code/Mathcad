{
  "name": "formelwerk",
  "private": true,
  "version": "1.0.0",
  "description": "FormelWerk – modernes technisches Rechenblatt mit Mathcad-Import",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify:mathcad": "vitest run tests/import.verify.test.ts",
    "e2e": "node e2e/run.mjs"
  },
  "dependencies": {
    "jszip": "^3.10.2",
    "katex": "^0.19.1",
    "mathjs": "^15.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/katex": "^0.16.8",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.0",
    "typescript": "5.9",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
